# Preserve the exact upstream bytes verified by the library manifest.
public/libraries/** -text -whitespace
public/notices/** -whitespace
scripts/retired/** -text -whitespace
# Content-addressed thumbnail sheets and their hash-pinned index.
public/thumbnails/** -text -whitespace
# Preserve byte-exact upstream fixtures, including CRLF and final blank lines.
fixtures/instructions/omr/*.mpd -text -whitespace
# Preserve exact model inputs, including the runner's final blank separator.
docs/samples/lego-style-study/fresh-e/*/prompt.md -text whitespace=-blank-at-eof
docs/samples/lego-style-study/diorama/sol-*/prompt.md -text whitespace=-blank-at-eof
docs/samples/style-self-improvement/round-*/*/prompt.md -text whitespace=-blank-at-eof

# Preserve exact filled experimental model inputs.
docs/samples/style-directions/*/prompt.md -text whitespace=-blank-at-eof
