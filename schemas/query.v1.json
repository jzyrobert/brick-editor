{
  "$id": "query",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "colorCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "layerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "occurrenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 393409,
        "format": "occurrence-id"
      },
      "maxItems": 200000
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "all"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "visible"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "layers"
            },
            "layerIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "maxItems": 200000
            }
          },
          "required": [
            "kind",
            "layerIds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "selection"
            },
            "occurrenceIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 5,
                "maxLength": 393409,
                "format": "occurrence-id"
              },
              "maxItems": 200000
            }
          },
          "required": [
            "kind",
            "occurrenceIds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "submodel"
            },
            "occurrenceId": {
              "type": "string",
              "minLength": 5,
              "maxLength": 393409,
              "format": "occurrence-id"
            }
          },
          "required": [
            "kind",
            "occurrenceId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "selection": {
      "type": "boolean"
    },
    "connectivity": {
      "enum": [
        "unverified",
        "verified"
      ]
    },
    "spatial": {
      "type": "boolean"
    },
    "intersectingCandidates": {
      "type": "boolean"
    },
    "bounds": {
      "type": "object",
      "properties": {
        "min": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "max": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "mode": {
          "enum": [
            "intersects",
            "contained"
          ]
        }
      },
      "required": [
        "min",
        "max",
        "mode"
      ],
      "additionalProperties": false
    }
  },
  "required": [],
  "additionalProperties": false
}
