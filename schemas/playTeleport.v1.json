{
  "$id": "playTeleport",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "position": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "maxItems": 3,
      "minItems": 3
    },
    "policy": {
      "enum": [
        "safe",
        "free-flight"
      ]
    },
    "yaw": {
      "type": "number"
    },
    "pitch": {
      "type": "number"
    }
  },
  "required": [
    "position"
  ],
  "additionalProperties": false
}
