{
  "$id": "inventoryPreview",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "previewId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "documentRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mappingPackSha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "projectHash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "sourceOccurrenceCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "resolvedPhysicalUnitCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lotCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "canExportComplete": {
      "type": "boolean"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "colorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "occurrenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 5,
              "maxLength": 393409,
              "format": "occurrence-id"
            },
            "maxItems": 200000
          },
          "layers": {
            "type": "object",
            "maxProperties": 10000,
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "propertyNames": {
              "not": {
                "enum": [
                  "__proto__",
                  "constructor",
                  "prototype"
                ]
              }
            }
          },
          "verification": {
            "enum": [
              "verified",
              "acknowledged"
            ]
          },
          "colorExistence": {
            "enum": [
              "verified",
              "derived",
              "not-produced",
              "not-recorded",
              "unknown"
            ]
          }
        },
        "required": [
          "itemId",
          "colorId",
          "quantity",
          "occurrenceIds",
          "layers",
          "verification",
          "colorExistence"
        ],
        "additionalProperties": false
      },
      "maxItems": 200000
    },
    "resolution": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part": {
            "type": "string",
            "pattern": "^(official|project|missing):[^\\s:][^:]{0,1023}$"
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "namespace": {
            "enum": [
              "official",
              "project",
              "missing"
            ]
          },
          "colorCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "colorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "quantity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "occurrenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 5,
              "maxLength": 393409,
              "format": "occurrence-id"
            },
            "maxItems": 200000
          },
          "tier": {
            "enum": [
              "verified",
              "reviewed",
              "derived",
              "ambiguous",
              "unmapped",
              "custom"
            ]
          },
          "mapping": {
            "enum": [
              "verified",
              "reviewed",
              "derived",
              "ambiguous",
              "unmapped",
              "custom",
              "user",
              "override",
              "excluded"
            ]
          },
          "itemId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "suggestedItemId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "maxItems": 100
          },
          "origin": {
            "enum": [
              "candidate",
              "derived",
              "reviewed",
              "user"
            ]
          },
          "colorExistence": {
            "enum": [
              "verified",
              "derived",
              "not-produced",
              "not-recorded",
              "unknown"
            ]
          },
          "colorAccepted": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "ready",
              "accepted",
              "needs-attention",
              "excluded"
            ]
          },
          "problems": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "maxItems": 100
          }
        },
        "required": [
          "part",
          "ref",
          "namespace",
          "colorCode",
          "quantity",
          "occurrenceIds",
          "tier",
          "mapping",
          "colorExistence",
          "colorAccepted",
          "status",
          "problems"
        ],
        "additionalProperties": false
      },
      "maxItems": 200000
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "message": {
            "type": "string",
            "maxLength": 4096
          },
          "severity": {
            "enum": [
              "warning",
              "error"
            ]
          },
          "occurrenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 5,
              "maxLength": 393409,
              "format": "occurrence-id"
            },
            "maxItems": 200000
          },
          "details": {}
        },
        "required": [
          "code",
          "message",
          "severity",
          "occurrenceIds"
        ],
        "additionalProperties": false
      },
      "maxItems": 200000
    },
    "excludedOccurrenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 393409,
        "format": "occurrence-id"
      },
      "maxItems": 200000
    },
    "substitutions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 393409,
        "format": "occurrence-id"
      },
      "maxItems": 200000
    },
    "request": {
      "$ref": "inventory"
    }
  },
  "required": [
    "previewId",
    "documentRevision",
    "mappingPackSha256",
    "projectHash",
    "sourceOccurrenceCount",
    "resolvedPhysicalUnitCount",
    "lotCount",
    "canExportComplete",
    "rows",
    "resolution",
    "diagnostics",
    "excludedOccurrenceIds",
    "substitutions",
    "request"
  ],
  "additionalProperties": false
}
