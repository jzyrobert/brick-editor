{
  "$id": "playTrainThrottle",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "trainId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "throttle": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    }
  },
  "required": [
    "throttle"
  ],
  "additionalProperties": false
}
