{
  "$id": "playRequest",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "worldProfile": {
      "type": "object",
      "properties": {
        "excludedLayerIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxItems": 10000,
          "uniqueItems": true
        }
      },
      "required": [
        "excludedLayerIds"
      ],
      "additionalProperties": false
    },
    "cameraSettings": {
      "type": "object",
      "properties": {
        "eyeHeight": {
          "type": "number",
          "minimum": 16,
          "maximum": 100
        },
        "fovDeg": {
          "type": "number",
          "minimum": 30,
          "maximum": 100
        },
        "near": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 2
        },
        "followDistance": {
          "type": "number",
          "minimum": 24,
          "maximum": 400
        },
        "minPitch": {
          "type": "number",
          "minimum": -1.48,
          "maximum": 0
        },
        "maxPitch": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.48
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "rigId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "rigIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "dynamicRigIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "maxItems": 14,
      "uniqueItems": true
    },
    "autoDoors": {
      "type": "boolean"
    },
    "trains": {
      "type": "boolean"
    },
    "locomotion": {
      "enum": [
        "walk",
        "fly-noclip"
      ]
    },
    "cameraMode": {
      "enum": [
        "first-person",
        "third-person"
      ]
    },
    "position": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "maxItems": 3,
      "minItems": 3
    },
    "yaw": {
      "type": "number"
    },
    "pitch": {
      "type": "number"
    },
    "ground": {
      "type": "boolean"
    },
    "realtime": {
      "type": "boolean"
    }
  },
  "required": [],
  "additionalProperties": false,
  "not": {
    "required": [
      "rigId",
      "rigIds"
    ]
  }
}
