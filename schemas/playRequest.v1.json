{
  "$id": "playRequest",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "rigId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "locomotion": {
      "enum": [
        "walk",
        "fly-noclip"
      ]
    },
    "cameraMode": {
      "enum": [
        "first-person",
        "third-person"
      ]
    },
    "position": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "maxItems": 3,
      "minItems": 3
    },
    "yaw": {
      "type": "number"
    },
    "pitch": {
      "type": "number"
    },
    "ground": {
      "type": "boolean"
    },
    "realtime": {
      "type": "boolean"
    }
  },
  "required": [],
  "additionalProperties": false
}
