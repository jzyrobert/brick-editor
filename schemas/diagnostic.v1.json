{
  "$id": "diagnostic",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "message": {
      "type": "string",
      "maxLength": 4096
    },
    "severity": {
      "enum": [
        "warning",
        "error"
      ]
    },
    "occurrenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 393409,
        "format": "occurrence-id"
      },
      "maxItems": 100000
    },
    "details": {}
  },
  "required": [
    "code",
    "message",
    "severity",
    "occurrenceIds"
  ],
  "additionalProperties": false
}
