{
  "$id": "mechanicalProposalRequest",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "enum": [
          "__proto__",
          "constructor",
          "prototype"
        ]
      }
    },
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "frameOccurrenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 393409,
        "format": "occurrence-id"
      },
      "maxItems": 2048,
      "minItems": 1,
      "uniqueItems": true
    },
    "occurrenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 393409,
        "format": "occurrence-id"
      },
      "maxItems": 2048,
      "minItems": 1,
      "uniqueItems": true
    },
    "includeHidden": {
      "type": "boolean"
    },
    "motors": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "mode": {
            "enum": [
              "position",
              "velocity"
            ]
          },
          "target": {
            "type": "number"
          },
          "maxEffort": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "const": "N*m"
              }
            },
            "required": [
              "value",
              "unit"
            ],
            "additionalProperties": false
          },
          "binding": {
            "type": "object",
            "properties": {
              "occurrenceId": {
                "type": "string",
                "minLength": 5,
                "maxLength": 393409,
                "format": "occurrence-id"
              },
              "profile": {
                "enum": [
                  "power-functions-motor-m-v1",
                  "power-functions-motor-l-v1"
                ]
              }
            },
            "required": [
              "occurrenceId",
              "profile"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "mode",
          "target",
          "maxEffort"
        ],
        "additionalProperties": false
      },
      "propertyNames": {
        "type": "string",
        "minLength": 5,
        "maxLength": 393409,
        "format": "occurrence-id"
      }
    }
  },
  "required": [
    "id",
    "name",
    "expectedRevision",
    "frameOccurrenceIds"
  ],
  "additionalProperties": false
}
