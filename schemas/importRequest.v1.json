{
  "$id": "importRequest",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "format": {
          "const": "ldraw"
        },
        "text": {
          "type": "string",
          "maxLength": 26214400
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "strict": {
          "type": "boolean"
        }
      },
      "required": [
        "format",
        "text"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "format": {
          "const": "native"
        },
        "bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "maxItems": 26214400
        },
        "strict": {
          "type": "boolean"
        }
      },
      "required": [
        "format",
        "bytes"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "format": {
          "const": "template"
        },
        "template": {
          "description": "Sample builds (offered in the chooser): blank, house, castle, car, jeep, windmill, lighthouse, cafe, playground, train, town, cathedral, harbour, motor-gears, large-motor, twin-drive, rack-drive, air-pump. Test fixtures (not in the chooser; kept for automation and tests): room, wall, 200, explore, mechanisms, seated-vehicle, door-room, physics.",
          "enum": [
            "blank",
            "house",
            "castle",
            "car",
            "jeep",
            "windmill",
            "lighthouse",
            "cafe",
            "playground",
            "train",
            "town",
            "cathedral",
            "harbour",
            "motor-gears",
            "large-motor",
            "twin-drive",
            "rack-drive",
            "air-pump",
            "room",
            "wall",
            "200",
            "explore",
            "mechanisms",
            "seated-vehicle",
            "door-room",
            "physics"
          ]
        }
      },
      "required": [
        "format",
        "template"
      ],
      "additionalProperties": false
    }
  ]
}
