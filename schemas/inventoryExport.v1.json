{
  "$id": "inventoryExport",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "previewId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expectedMappingPackSha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "errorPolicy": {
      "enum": [
        "block",
        "export-resolved"
      ]
    }
  },
  "required": [
    "previewId",
    "expectedRevision",
    "expectedMappingPackSha256",
    "errorPolicy"
  ],
  "additionalProperties": false
}
