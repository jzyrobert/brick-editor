{
  "$id": "project",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "maxLength": 4096
    },
    "units": {
      "const": "LDU"
    },
    "rootModelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "library": {
      "type": "object",
      "properties": {
        "releaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "manifestSha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "colorConfigSha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "connectorPackId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "connectorPackSha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "full": {
          "type": "object",
          "properties": {
            "releaseId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "manifestSha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "connectorPackId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "connectorPackSha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "releaseId",
            "manifestSha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "releaseId",
        "manifestSha256",
        "colorConfigSha256"
      ],
      "additionalProperties": false
    },
    "marketplace": {
      "type": "object",
      "properties": {
        "mappingPackId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "mappingPackSha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "overrides": {
          "type": "object",
          "maxProperties": 10000,
          "additionalProperties": {
            "type": "object",
            "properties": {
              "itemId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "colorId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "acknowledged": {
                "type": "boolean"
              },
              "substitution": {
                "type": "boolean"
              }
            },
            "required": [
              "itemId",
              "colorId",
              "acknowledged",
              "substitution"
            ],
            "additionalProperties": false
          },
          "propertyNames": {
            "type": "string",
            "minLength": 5,
            "maxLength": 393409,
            "format": "occurrence-id"
          }
        }
      },
      "required": [
        "mappingPackId",
        "mappingPackSha256",
        "overrides"
      ],
      "additionalProperties": false
    },
    "models": {
      "type": "object",
      "maxProperties": 10000,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "kind": {
                  "enum": [
                    "part",
                    "submodel",
                    "geometry"
                  ]
                },
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "colorCode": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "transform": {
                  "type": "object",
                  "properties": {
                    "position": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "maxItems": 3,
                      "minItems": 3
                    },
                    "basis": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "maxItems": 9,
                      "minItems": 9
                    }
                  },
                  "required": [
                    "position",
                    "basis"
                  ],
                  "additionalProperties": false
                },
                "sourceRecordId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              },
              "required": [
                "id",
                "kind",
                "ref",
                "colorCode",
                "transform"
              ],
              "additionalProperties": false
            },
            "maxItems": 100000
          },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "raw": {
                  "type": "string",
                  "maxLength": 4096
                },
                "nodeId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              },
              "required": [
                "id",
                "raw"
              ],
              "additionalProperties": false
            },
            "maxItems": 1000000
          },
          "classification": {
            "enum": [
              "model",
              "custom"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "nodes",
          "records",
          "classification"
        ],
        "additionalProperties": false
      },
      "propertyNames": {
        "not": {
          "enum": [
            "__proto__",
            "constructor",
            "prototype"
          ]
        }
      }
    },
    "layers": {
      "type": "object",
      "maxProperties": 10000,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "name": {
            "type": "string",
            "maxLength": 4096
          },
          "visible": {
            "type": "boolean"
          },
          "locked": {
            "type": "boolean"
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
