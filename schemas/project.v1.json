        "labels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "text": {
                "type": "string",
                "maxLength": 80
              },
              "position": {
                "type": "array",
                "items": {
                  "type": "number"
