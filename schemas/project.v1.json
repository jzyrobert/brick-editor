          "projection": {
            "enum": [
              "perspective",
              "orthographic"
            ]
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3
          },
          "target": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3
          },
          "up": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3
          },
          "fovDeg": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 180
          },
          "near": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "far": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "span": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "space",
          "projection",
          "position",
          "target",
          "up",
          "fovDeg",
          "near",
          "far"
        ],
        "additionalProperties": false
      },
      "propertyNames": {
        "not": {
          "enum": [
            "__proto__",
            "constructor",
            "prototype"
          ]
        }
      }
