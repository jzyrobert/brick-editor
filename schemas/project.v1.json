    "layerFolders": {
      "type": "object",
      "maxProperties": 10000,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "name": {
            "type": "string",
            "maxLength": 4096
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
