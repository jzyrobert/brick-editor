        "views": {
          "type": "object",
          "maxProperties": 10000,
          "additionalProperties": {
            "type": "object",
            "properties": {
              "floorId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "ghostBelow": {
                "type": "boolean"
              }
            },
            "required": [
              "floorId",
              "ghostBelow"
            ],
            "additionalProperties": false
          },
          "propertyNames": {
            "not": {
              "enum": [
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          }
        }
      },
      "required": [
        "floors",
        "labels",
        "views"
      ],
      "additionalProperties": false
