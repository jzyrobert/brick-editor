                "maxItems": 3,
                "minItems": 3
              },
              "floorId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "id",
              "text",
              "position"
            ],
            "additionalProperties": false
          },
          "maxItems": 500
