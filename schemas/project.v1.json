    "scene": {
      "type": "object",
      "properties": {
        "backdrop": {
          "enum": [
            "blank",
            "grass",
            "street",
            "beach",
            "night",
            "studio"
          ]
        },
        "playHint": {
          "type": "string",
          "maxLength": 80
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "motionRigs": {
      "type": "object",
      "maxProperties": 10000,
      "additionalProperties": {},
      "propertyNames": {
        "not": {
          "enum": [
            "__proto__",
            "constructor",
            "prototype"
          ]
        }
      }
    },
    "metadata": {
      "type": "object",
      "maxProperties": 10000,
      "additionalProperties": {},
      "propertyNames": {
        "not": {
          "enum": [
            "__proto__",
            "constructor",
            "prototype"
          ]
        }
      }
    },
    "assets": {
      "type": "object",
      "maxProperties": 10000,
      "additionalProperties": {
        "type": "string",
        "maxLength": 4096
      },
      "propertyNames": {
        "not": {
          "enum": [
            "__proto__",
            "constructor",
            "prototype"
          ]
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "message": {
            "type": "string",
            "maxLength": 4096
          },
          "severity": {
            "enum": [
              "warning",
              "error"
            ]
          },
          "occurrenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 5,
              "maxLength": 393409,
              "format": "occurrence-id"
            },
            "maxItems": 100000
          },
          "details": {}
        },
        "required": [
          "code",
          "message",
          "severity",
          "occurrenceIds"
        ],
        "additionalProperties": false
      },
      "maxItems": 100000
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "title",
    "units",
    "rootModelId",
    "library",
    "marketplace",
    "models",
    "layers",
    "defaultLayerId",
    "layerAssignments",
    "groups",
    "instructionPlans",
    "cameraBookmarks",
    "motionRigs",
    "metadata",
    "assets",
    "diagnostics"
  ],
  "additionalProperties": false
}
