    "architecture": {
      "type": "object",
      "properties": {
        "floors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "name": {
                "type": "string",
                "maxLength": 60
