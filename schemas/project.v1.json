          "parentFolderId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "id",
          "name",
          "order"
        ],
        "additionalProperties": false
      },
      "propertyNames": {
        "not": {
          "enum": [
            "__proto__",
            "constructor",
            "prototype"
          ]
        }
      }
    },
    "defaultLayerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "layerAssignments": {
      "type": "object",
      "maxProperties": 10000,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "propertyNames": {
        "type": "string",
        "minLength": 5,
        "maxLength": 393409,
        "format": "occurrence-id"
      }
    },
    "groups": {
      "type": "object",
      "maxProperties": 10000,
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 5,
          "maxLength": 393409,
          "format": "occurrence-id"
        },
        "maxItems": 100000
      },
      "propertyNames": {
        "not": {
          "enum": [
            "__proto__",
            "constructor",
            "prototype"
          ]
        }
      }
    },
    "instructionPlans": {
      "type": "object",
      "maxProperties": 10000,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 4096
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 5,
                "maxLength": 393409,
                "format": "occurrence-id"
              },
              "maxItems": 100000
            },
            "maxItems": 100000
          },
          "stepMetadata": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "notes": {
                  "type": "string",
                  "maxLength": 4096
                },
                "camera": {
                  "type": "object",
                  "properties": {
                    "space": {
                      "const": "ldraw"
                    },
                    "projection": {
                      "enum": [
                        "perspective",
                        "orthographic"
                      ]
                    },
                    "position": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "maxItems": 3,
                      "minItems": 3
                    },
                    "target": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "maxItems": 3,
                      "minItems": 3
                    },
                    "up": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "maxItems": 3,
                      "minItems": 3
                    },
                    "fovDeg": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "exclusiveMaximum": 180
                    },
                    "near": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "far": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "span": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "space",
                    "projection",
                    "position",
                    "target",
                    "up",
                    "fovDeg",
                    "near",
                    "far"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "maxItems": 100000
          }
        },
        "required": [
          "name",
          "steps"
        ],
        "additionalProperties": false
      },
      "propertyNames": {
        "not": {
          "enum": [
            "__proto__",
            "constructor",
            "prototype"
          ]
        }
      }
