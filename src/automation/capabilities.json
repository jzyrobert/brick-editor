{
  "apiVersion": "1.0",
  "release": "development",
  "milestone": "Core editor with selected M2\u2013M5 features; remaining acceptance gates documented",
  "features": {
    "ldraw": {
      "parsed": [
        "1",
        "2",
        "3",
        "4",
        "5",
        "FILE",
        "NOFILE",
        "STEP",
        "ROTSTEP",
        "BFC",
        "!COLOUR"
      ],
      "rendered": [
        "references",
        "polygons",
        "ordinary lines",
        "conditional lines",
        "BFC",
        "current/fixed colours"
      ],
      "roundTripPreserved": [
        "source records",
        "unknown metadata",
        "texture records",
        "affine transforms",
        "embedded definitions"
      ],
      "unsupported": [
        "texture projection",
        "glitter/speckle fidelity",
        "whole-library geometry",
        "automatic dependency fetch"
      ]
    },
    "editing": {
      "commands": true,
      "transactions": true,
      "undoRedo": true,
      "occurrenceCopyOnWrite": true,
      "gridPlacement": true,
      "snapVerified": false,
      "physicsSupported": false,
      "sourcePrimitiveDuplication": true,
      "projectReplacementUndo": false,
      "clipboardFragments": true,
      "linearCircularArrays": true,
      "layerReorderDeleteUI": true,
      "transformHandles": true,
      "transientTransformPreview": true,
      "boxLassoSelection": true,
      "visibleSurfaceSelection": "Depth-tested ID pass at one sample per CSS pixel",
      "throughSelection": "Clipped triangle intersection; bounded workload",
      "selectionAddRemoveToggle": true,
      "matchingSelection": true,
      "layerDuplication": true,
      "layerFolders": true,
      "ghostOtherLayers": true,
      "workplanes": ["world", "picked-face", "numerical"],
      "rotatedFill": true,
      "shortcutRemapping": true,
      "makeSubmodel": "contiguous sibling selection",
      "makeUnique": true,
      "sharedDefinitionEditing": [
        "recolour",
        "local translation",
        "local pivot rotation"
      ],
      "allowedPartFill": {
        "algorithm": "deterministic largest-first greedy",
        "quarterTurns": true,
        "cellMask": true,
        "sameHeightOnly": true,
        "workerCancellation": true
      },
      "rigAuthoringUI": "create/edit/remove representable single-joint or pure planar vehicle rigs; preserved frames, axes, IDs, limits and motor metadata",
      "sourceOnlyAdmission": "Source-valid projects above derived occurrence budgets retain native/LDraw backup and local recovery; derived editing, rendering and Play refuse with structured limits",
      "driverSeatMetadataUI": true
    },
    "inventory": {
      "format": "bricklink-wanted-xml",
      "offline": true,
      "starterParts": 6,
      "completeExportBlocksUnresolved": true,
      "partialReportArchive": true,
      "liveDestinationTest": false
    },
    "render": {
      "webgl2": true,
      "png": true,
      "offscreenCapture": true,
      "idleOnDemand": true,
      "instanced": true,
      "qualityProfilesDistinct": true,
      "coverage": "Opaque non-reflected non-sheared mesh instancing; merged ordinary/conditional lines; transparent/reflected/sheared fallback; image parity fixtures",
      "contextRestoration": true,
      "interruptedCaptureRefusal": true
    },
    "instructions": {
      "layerPlans": true,
      "assemblyValidation": false,
      "pdf": true,
      "rootImportedSteps": true,
      "rotstepCameraSemantics": false,
      "pngArchive": true,
      "htmlArchive": true,
      "coverageValidated": true,
      "editablePlans": true,
      "stepReorderSplitMerge": true,
      "stepNotes": true,
      "stepCameras": true,
      "dimPreviousParts": true,
      "importedStepBudgetPolicy": "Preserve source STEP/ROTSTEP records and defer derived instruction plans when expansion exceeds policy"
    },
    "play": {
      "available": true,
      "engine": "@dimforge/rapier3d-compat@0.21.0",
      "fixedHz": 60,
      "firstPerson": true,
      "thirdPersonRigidJoints": true,
      "walk": true,
      "flyNoclip": true,
      "touchControls": true,
      "authoringIsolation": true,
      "poseApplication": true,
      "dynamicMechanisms": false,
      "collision": "Actual transformed triangle surfaces; capsule controller; optional session ground",
      "profile": "original-brick-figure-v1",
      "coverage": "See docs/STATUS.md and Play acceptance tests; not universal model traversability",
      "kinematicMechanisms": true,
      "movingKinematicColliders": true,
      "movingColliderPolicy": "Authored rigid-group triangle surfaces; conservatively stop before touching walking or seated actor; certified own-vehicle seated attachment; no pushing or dynamic response",
      "cameraSettings": true,
      "validatedSessionSpawns": true,
      "remappablePlayKeys": true,
      "explicitLayerInclusion": true,
      "editorVisibilityIndependent": true,
      "multipleActiveRigs": {
        "maxRigs": 32,
        "maxGroups": 128,
        "maxMovingTriangles": 200000
      },
      "nearbyInteraction": "E/touch authored joint toggle, remote vehicle control, and explicit authored driver-seat entry/exit",
      "jointTargetAnimation": {
        "fixedTickHz": 60,
        "kinds": ["revolute", "prismatic"],
        "units": {
          "revolute": "degrees; degrees/s",
          "prismatic": "LDU; LDU/s"
        },
        "speedBounds": {
          "minimum": 0.001,
          "revoluteMaximum": 3600,
          "prismaticMaximum": 10000
        },
        "blockedPolicy": "Keep last accepted tick pose; stop target until explicit retry",
        "pausePolicy": "Pause stops realtime; explicit manual ticks still advance; capture refuses mutations",
        "authoredChanges": false
      },
      "vehicleWorldCollision": {
        "profile": "source-boxes-v1",
        "policy": "Conservative swept chassis and wheel envelopes against complete included static and foreign-rig triangle geometry; refuse unsupported geometry or exhausted query budgets",
        "dynamicResponse": false,
        "riding": true
      },
      "seatedVehicles": {
        "profile": "brick-figure-open-seat-v1",
        "authoring": "Explicit chassis-local pelvis/access/approach and 1\u20134 ordered standing exits; metadata review and undoable save",
        "body": "Independent compound boxes enclosing original rigid straight-leg seated visual; no mesh-derived physics",
        "entry": "Reach, access ray, supported approach, wheel-envelope clearance and swept raised transfer; refuse before mutation",
        "driving": "Conservative vehicle and rider sweeps; retain accepted poses when blocked",
        "exit": "Current-frame authored exits with real walkable support and swept transfer; blocked exit retains occupancy",
        "scope": "Supported upright unarticulated chassis/wheel rigs only; no inferred seats, low cabins, general platform riding or dynamic suspension"
      }
    },
    "sharing": {
      "selfContainedMpdLinks": true,
      "softUrlBytes": 8192,
      "hardUrlBytes": 32768,
      "decompressedBytes": 4194304,
      "previewBeforeOpen": true
    },
    "offline": {
      "optInAppSnapshot": true,
      "starterLibrary": true,
      "preservesOldVersions": true
    },
    "persistence": {
      "autosaveDebounceMs": 750,
      "autosaveMaxDelayMs": 3000,
      "nativeSourceFiles": true,
      "nativeAssetFiles": true,
      "localProjectManagement": true,
      "conflictFork": true,
      "indexedDbWriteCoordination": true,
      "otherTabNotifications": true,
      "backupBeforeReload": true
    },
    "exportProfiles": {
      "profiles": ["standard", "portable", "layers", "native"],
      "officialGeometryArchive": true,
      "recipientColourConfigurationRequired": true,
      "directArchiveImport": false
    },
    "automationQueries": {
      "scope": true,
      "currentSelection": true,
      "sourceBounds": "conservative transformed source boxes, including studs and primitive endpoints",
      "intersectionCandidates": "bounded broad-phase only; no verified collision or connectivity claim",
      "headlessWithoutWebGL": true,
      "cli": true,
      "connectorCoverage": "unverified"
    }
  },
  "limits": {
    "importBytes": 26214400,
    "decompressedBytes": 104857600,
    "referenceDepth": 64,
    "occurrences": 100000,
    "additions": 10000,
    "imagePixels": 16000000,
    "renderOccurrences": 5000,
    "renderPrototypeVariants": 128,
    "customCompilationSourceBytes": 52428800,
    "selectionPixels": 4000000,
    "selectionPolygonPoints": 2048,
    "selectionTriangleTests": 5000000,
    "selectionIntersectionWork": 20000000,
    "transformHandleSelection": 1000,
    "queryIntersectionComparisons": 2000000,
    "queryIntersectionCandidates": 10000,
    "queryDependencyWork": 2000000,
    "queryAdditionalTextBudgetBytes": 8388608,
    "queryDiagnosticItems": 2000000,
    "requestBytes": 26214400,
    "requestValues": 1000000,
    "requestContainerDepth": 128,
    "occurrenceIdEncodedCharacters": 393409,
    "nodeIdCodePoints": 1024
  },
  "deduplication": {
    "entries": 500,
    "persistence": "session only"
  },
  "history": {
    "entries": 100,
    "bytes": 8388608
  },
  "unimplemented": [
    "connector snapping",
    "path tracing",
    "collaboration",
    "geometry sharing across colour variants",
    "composite purchasing decomposition",
    "full native migrations",
    "full physical-device acceptance",
    "dynamic mechanisms and suspension",
    "instruction annotations and callouts",
    "advanced material/texture fidelity",
    "connected-assembly selection without connector coverage",
    "general structural regrouping",
    "whole-library BFC conformance beyond audited fixtures"
  ]
}
