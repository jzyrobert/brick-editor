      "css": ".ds-primary{font-family:var(--font-sans);font-size:var(--text-body);font-variant-numeric:tabular-nums;cursor:pointer;min-height:44px;padding:0 16px;border:0;border-radius:var(--r-key);font-weight:700;background:var(--accent);color:var(--card);box-shadow:0 4px 10px #202a3c18;transition:background .18s,transform .18s,box-shadow .18s}.ds-primary:hover{background:var(--accent-deep);transform:translateY(-1px)}.ds-primary:active{transform:translateY(2px)}.ds-primary:focus-visible{outline:3px solid var(--sun);outline-offset:2px}.ds-primary:disabled{opacity:.4;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Secondary model tool",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Quiet model-view action used below exploration.",
      "html": "<button class=\"ds-secondary\">Instructions</button>",
      "css": ".ds-secondary{font-family:var(--font-sans);font-size:var(--text-body);font-variant-numeric:tabular-nums;cursor:pointer;min-height:44px;padding:9px 13px;border:0;border-radius:var(--r-field);background:#ede7dc;color:var(--ink);font-weight:600;transition:background .15s,border-color .15s}.ds-secondary:hover{background:var(--paper);border-color:var(--sheet-handle)}.ds-secondary:focus-visible{outline:3px solid var(--sun);outline-offset:2px}.ds-secondary:disabled{opacity:.4;cursor:not-allowed}"
    },
    {
      "name": "Gallery and Play navigation",
      "kind": "nav",
      "refersTo": "mode-active",
      "description": "Recessed navy primary modes, with paper identifying the current mode.",
      "html": "<nav class=\"ds-modes\" aria-label=\"Main modes\"><button aria-pressed=\"true\">Gallery</button><button aria-pressed=\"false\">Play</button></nav>",
      "css": ".ds-modes{display:inline-flex;gap:4px;padding:5px;border-radius:var(--r-card);background:#141e30}.ds-modes button{font-family:var(--font-sans);font-size:var(--text-body);font-variant-numeric:tabular-nums;cursor:pointer;min-height:44px;min-width:106px;padding:0 20px;border:0;border-radius:var(--r-field);background:transparent;color:var(--paper);font-weight:700;transition:background .15s}.ds-modes button[aria-pressed=true]{background:var(--paper);color:var(--ink)}.ds-modes button:hover{background:var(--hud-hover)}.ds-modes button[aria-pressed=true]:hover{background:#ede7dc}.ds-modes button:focus-visible{outline:3px solid var(--sun);outline-offset:2px}"
    },
    {
      "name": "Shared viewing angles",
      "kind": "nav",
      "refersTo": "angle-active",
      "description": "Warm segmented tabs with a raised white active angle.",
      "html": "<div class=\"ds-angles\" role=\"group\" aria-label=\"Model viewing angle\"><button aria-pressed=\"true\">Isometric</button><button aria-pressed=\"false\">Front</button><button aria-pressed=\"false\">Top</button></div>",
      "css": ".ds-angles{display:inline-flex;padding:4px;border-radius:var(--r-key);background:var(--tab-well)}.ds-angles button{font-family:var(--font-sans);font-size:var(--text-body);font-variant-numeric:tabular-nums;cursor:pointer;min-height:44px;padding:0 14px;border:0;border-radius:var(--r-field);background:transparent;color:var(--secondary);transition:background .15s}.ds-angles button:hover{background:var(--paper)}.ds-angles button[aria-pressed=true]{background:var(--card);color:var(--ink);font-weight:700;box-shadow:0 2px 6px #202a3c10}.ds-angles button:focus-visible{outline:3px solid var(--sun);outline-offset:2px}"
    },
    {
      "name": "Sheet text field",
      "kind": "input",
      "refersTo": "field",
      "description": "The existing white field with current warm tokens and touch sizing.",
      "html": "<label class=\"ds-field-label\">Search parts<input class=\"ds-field\" type=\"search\" placeholder=\"Part name or number\"></label>",
      "css": ".ds-field-label{display:grid;gap:8px;color:var(--ink);font-family:var(--font-sans);font-size:var(--text-body)}.ds-field{min-width:0;min-height:44px;padding:9px 10px;border:1px solid var(--line);border-radius:var(--r-field);background:var(--card);color:var(--ink);font:inherit;caret-color:var(--accent)}.ds-field:focus-visible{outline:3px solid var(--sun);outline-offset:2px}@media(max-width:650px){.ds-field{font-size:var(--text-field-touch)}}"
    },
    {
      "name": "Sheet filter chips",
      "kind": "chip",
      "refersTo": "filter-chip-active",
      "description": "Pill filters invert to navy when pressed and expand on touch.",
      "html": "<div class=\"ds-chips\"><button aria-pressed=\"true\">All</button><button aria-pressed=\"false\">Bricks</button><button aria-pressed=\"false\">Plates</button></div>",
      "css": ".ds-chips{display:flex;flex-wrap:wrap;gap:6px}.ds-chips button{font-family:var(--font-sans);font-size:var(--text-body);font-variant-numeric:tabular-nums;cursor:pointer;min-height:36px;padding:0 12px;border:1px solid var(--line);border-radius:var(--r-sheet);background:var(--card);color:var(--ink);font-size:var(--text-label);transition:background .15s,border-color .15s}.ds-chips button:hover{background:var(--paper);border-color:var(--sheet-handle)}.ds-chips button[aria-pressed=true]{background:var(--ink);border-color:var(--ink);color:var(--chalk)}.ds-chips button:focus-visible{outline:3px solid var(--sun);outline-offset:2px}@media(pointer:coarse){.ds-chips button{min-height:44px}}"
    },
    {
      "name": "Effort badge",
      "kind": "chip",
      "refersTo": "effort-badge",
      "description": "Factual model metadata in peach and dark clay.",
      "html": "<span class=\"ds-effort\">high effort</span>",
      "css": ".ds-effort{display:inline-block;padding:6px 10px;border-radius:var(--r-field);background:var(--grass);color:var(--grass-ink);font-family:var(--font-sans);font-size:var(--text-label);font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Part choice card",
      "kind": "card",
      "refersTo": "part-card",
      "description": "Inventory choice using warm selected borders and an explicit check.",
      "html": "<button class=\"ds-part\" aria-pressed=\"true\"><svg class=\"ds-check\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg><strong>Brick 2 × 4</strong><small>3001</small></button>",
      "css": ".ds-part{font-family:var(--font-sans);font-size:var(--text-body);font-variant-numeric:tabular-nums;cursor:pointer;position:relative;display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-end;min-width:140px;min-height:0;padding:6px 6px 7px;border:2px solid var(--line);border-radius:var(--r-card);background:var(--card);color:var(--ink);text-align:left;transition:background .15s,border-color .15s}.ds-part:hover{border-color:var(--sheet-handle)}.ds-part[aria-pressed=true]{border-color:var(--grass);box-shadow:inset 0 0 0 1px var(--grass)}.ds-part strong{font-size:var(--text-label);font-weight:600;line-height:1.2;min-height:2.4em;margin:2px 0 1px}.ds-part small{font-size:var(--text-label);color:var(--secondary)}.ds-check{position:absolute;top:9px;right:9px;color:var(--accent)}.ds-part:focus-visible{outline:3px solid var(--sun);outline-offset:2px}"
    },
    {
      "name": "Model tools panel",
      "kind": "custom",
      "refersTo": "model-tools",
      "description": "Paper tool menu with a display title and peach icon wells.",
      "html": "<section class=\"ds-tools\" aria-label=\"Model tools\"><h2>Model tools</h2><p>Work with the same model.</p><button><span class=\"ds-tool-icon\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"8\" rx=\"1.5\"/><path d=\"M7 11V8.5h3V11M14 11V8.5h3V11\"/></svg></span><span><strong>Build</strong><small>Place, move and colour parts</small></span></button></section>",
      "css": ".ds-tools{width:360px;max-width:calc(100vw - 28px);padding:22px;border-radius:var(--r-dock);background:var(--paper);color:var(--ink);box-shadow:0 14px 40px #18213433;font-family:var(--font-sans);font-size:var(--text-body)}.ds-tools h2{margin:0;font:750 26px/1.1 var(--font-display);letter-spacing:-.03em}.ds-tools p{margin:12px 0 18px;color:var(--secondary);line-height:1.65}.ds-tools button{font-family:var(--font-sans);font-size:var(--text-body);font-variant-numeric:tabular-nums;cursor:pointer;display:flex;align-items:center;gap:12px;width:100%;min-height:74px;padding:12px 4px;border:0;border-radius:var(--r-field);background:transparent;color:var(--ink);text-align:left;transition:background .15s}.ds-tools button:hover{background:#f0e6d7}.ds-tool-icon{display:grid;place-items:center;flex-shrink:0;width:40px;height:40px;background:var(--grass);color:var(--accent);border-radius:var(--r-key)}.ds-tools strong,.ds-tools small{display:block}.ds-tools small{color:var(--secondary);font-size:var(--text-label);line-height:1.5;margin-top:4px}.ds-tools button:focus-visible{outline:3px solid var(--sun);outline-offset:2px}"
    },
    {
      "name": "Play settings tabs",
      "kind": "nav",
      "refersTo": "play-settings-tab-active",
      "description": "Scoped Play settings tabs preserve separate readable labels on narrow phones.",
      "html": "<div class=\"ds-play-tabs\" role=\"tablist\" aria-label=\"Play\"><button role=\"tab\" aria-selected=\"true\">Mechanisms</button><button role=\"tab\" aria-selected=\"false\">Layers &amp; ground</button><button role=\"tab\" aria-selected=\"false\">Keyboard</button></div>",
      "css": ".ds-play-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:4px;width:300px;padding:3px;border-radius:var(--r-card);background:var(--tab-well)}.ds-play-tabs button{min-width:0;min-height:48px;margin:0;padding:8px;border:0;border-radius:9px;background:transparent;color:var(--secondary);font-family:var(--font-sans);font-size:var(--text-label);font-weight:650;white-space:normal;cursor:pointer;transition:background .15s,border-color .15s}.ds-play-tabs button:hover{background:var(--paper)}.ds-play-tabs button[aria-selected=true]{background:var(--ink);color:var(--chalk)}.ds-play-tabs button:focus-visible{outline:3px solid var(--sun);outline-offset:2px}@media(prefers-reduced-motion:reduce){.ds-play-tabs button{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "The Builder’s Workshop",
    "overview": "Warm paper, expressive headings and quietly coloured model stages make builds feel close enough to handle. Deep navy carries navigation and floating controls; burnt orange marks actions and focus. The model remains the largest visual surface, with supporting facts and attribution set in practical, legible type.\n\nThe cream ground is the approved production identity. Gallery gives models room to be compared, while the editor and Play keep useful controls compact around the live scene. The product name remains brickeditor. New surfaces share these materials and type roles without copying any one screen’s composition.",
    "keyCharacteristics": [
      "Warm paper with navy control surfaces and burnt-orange actions.",
      "Locally hosted expressive headings and practical system body text.",
      "Broad peach, sage and sand stages with factual, compact model labels.",
      "Phone layouts that preserve the model and reachable controls."
    ],
    "rules": [
      {
        "name": "The Action Accent Rule",
        "body": "Use burnt orange for actions, focus and concise state indicators; let model geometry supply the richest colour.",
        "section": "colors"
      },
      {
        "name": "The Practical Type Rule",
        "body": "Use the display face for headings and short model names; keep facts, instructions, fields and controls in the system body face.",
        "section": "typography"
      },
      {
        "name": "The Model Space Rule",
        "body": "Reduce secondary chrome and disclose tools progressively before reducing the model area or touch targets.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do keep warm paper as the application ground and navy as the control material.",
      "Do give models more area than supporting controls and metadata.",
      "Do use the existing orange focus ring and preserve accessible labels when visible text disappears.",
      "Do keep touch targets at least 44px and respect safe-area insets and reduced motion.",
      "Do use same-origin assets, the self-hosted display font and the authored SVG icon family.",
      "Do distinguish actual responses, source facts and placeholders with plain labels."
    ],
    "donts": [
      "Don’t restore green or gold through the legacy grass and sun token names; their current values are warm peach and orange.",
      "Don’t make stage colour an agent identity or an interaction state.",
      "Don’t wrap every gallery response in a raised, bordered card.",
      "Don’t hide an essential action behind hover alone or shrink touch controls to fit.",
      "Don’t imitate LEGO logos, wordmarks or trade dress.",
      "Don’t load remote fonts or hotlinked images."
    ]
  }
}
